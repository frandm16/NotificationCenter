# Database
DB_NAME=notification_center
DB_USER=notification_user
DB_PASSWORD=change_this_secret_password
DB_HOST=db
DB_PORT=5432

# Backend Ports & Security
BACKEND_PRIVATE_PORT=8080
BACKEND_PUBLIC_PORT=8083
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long_for_security
COOKIE_SECURE=false
CORS_ALLOWED_ORIGIN=http://localhost:7778

# Single User Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately
# Optional BCrypt hash for ADMIN_PASSWORD (takes precedence if set)
# ADMIN_PASSWORD_HASH=$2a$10$...

# VAPID Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@frandm.dev

# Frontend
FRONTEND_PORT=7778
VITE_API_BASE_URL=/api/v1
